message: "Cite the version of the OASI software/data release used. This release is a results-only study supplement."
title: "OASI Operant Evidence: Bounded Host-Process Experiment and Passive Readback"
type: software
authors:
  - family-names: "Messaoudene"
    given-names: "Mohammed"
    orcid: "https://orcid.org/0009-0007-4665-2548"
version: "0.4.0-research-preview"
